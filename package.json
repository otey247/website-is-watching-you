{
  "name": "the-website-is-watching-you",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An interactive psychological horror experience built with Three.js, behavioral telemetry and a procedural horror director.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.186.1",
    "xstate": "^5.33.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
